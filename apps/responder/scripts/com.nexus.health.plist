<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nexus.health</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/willfoti/.flint/nexus-health.sh</string>
  </array>

  <!-- 09:00 daily. RunAtLoad is off: loading this file is not a reason to spend on a
       probe, and a missed run is caught by the next one. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/willfoti/.flint/logs/nexus-health.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/willfoti/.flint/logs/nexus-health.err</string>
</dict>
</plist>
