<?xml version="1.0" encoding="UTF-8"?>
<!-- Nightly discovery: what models exist, what Flint is configured to use, what
     changed. Spends nothing (free model-list calls), so it runs unattended.
     Install: cp com.flint.evolve.plist ~/Library/LaunchAgents/ ;
              launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.flint.evolve.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.flint.evolve</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "$HOME/flint" &amp;&amp; pnpm --filter @flint/evolve discover</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/willfoti/.nvm/versions/node/v24.15.0/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/willfoti/.flint/evolve/discover.out.log</string>
  <key>StandardErrorPath</key><string>/Users/willfoti/.flint/evolve/discover.err.log</string>
</dict>
</plist>
