{
  "name": "@flint/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Flint's always-on runtime: the world model, the prediction ledger, approvals, audit and the jobs that keep them current. Loopback only; holds no vendor keys.",
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "prisma generate >/dev/null && tsc --noEmit",
    "test": "prisma generate >/dev/null && vitest run",
    "generate": "prisma generate",
    "backup": "tsx src/cli.ts backup",
    "drill": "tsx src/cli.ts drill",
    "enroll": "tsx src/cli.ts enroll",
    "offsite": "tsx src/cli.ts offsite"
  },
  "dependencies": {
    "@flint/policy": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "6.19.3",
    "fastify": "^5.12.0",
    "pg": "^8.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
