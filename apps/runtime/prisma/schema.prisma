// Flint runtime: governance, world model and prediction ledger (Machine plan P1).
//
// Conventions (plan 3.0.5):
//  - No Prisma enums. Every closed set is a String with a CHECK in the migration
//    SQL; a CHECK can be dropped and re-added in down.sql, an enum value cannot.
//  - Every DateTime is timestamptz(3); every id is a cuid.
//  - Triggers, CHECKs, grants and partitions are hand-written in the migrations.
//    The comment on each model says which ones guard it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// p1_governance

model ApprovalCredential {
  id           String     @id @default(cuid())
  credentialId String     @unique
  factor       String // CHECK webauthn|secure_enclave
  publicKey    Bytes // SPKI P-256
  label        String
  signCount    Int        @default(0)
  enrolledVia  String // "enroll_code" | "approval:<id>"
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  revokedAt    DateTime?  @db.Timestamptz(3)
  approvals    Approval[]
}

/// INSERT: flint_approver only. flint_app may set consumedAt once (approval_consume_once).
model Approval {
  id                String             @id @default(cuid())
  subjectType       String // CHECK proposal|goal|plan|task|policy|forget|void|correction|credential|partition_drop
  subjectId         String
  decision          String // CHECK approve|reject
  payload           Json // the exact canonical object signed
  challenge         String // sha256(canonical(payload)), hex
  credentialId      String
  credential        ApprovalCredential @relation(fields: [credentialId], references: [credentialId], onDelete: Restrict)
  authenticatorData Bytes? // webauthn only
  clientDataJson    Bytes? // webauthn only
  signature         Bytes
  note              String? // <= 500
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime           @db.Timestamptz(3)
  consumedAt        DateTime?          @db.Timestamptz(3)
  policies          ActionPolicy[]

  @@index([subjectType, subjectId])
}

/// Promotion rows. INSERT is checked against the approved policy proposal (action_policy_matches_approval).
model ActionPolicy {
  id         String   @id @default(cuid())
  pattern    String
  tier       String // CHECK alone|approval|forbidden
  dailyCap   Int?
  scope      Json?
  reason     String
  approvalId String
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)

  @@index([pattern, active])
}

/// Atomic caps, claimed at decision time.
model ActionCounter {
  action String
  day    String // YYYY-MM-DD, or YYYY-Www for weekly caps, in FLINT_TZ
  count  Int    @default(0)

  @@id([action, day])
}

/// Guarded by proposal_transition.
model Proposal {
  id             String    @id @default(cuid())
  kind           String // CHECK tool_call|goal|plan|rule|policy|task|pr|spend|forget|void
  origin         String // "chat:<conversationId>" | "runtime:<job>" | "console" | "cli"
  action         String
  templateId     String? // required when origin is runtime
  args           Json? // nulled by retention; <= 64 KB
  argsDigest     String
  argsProvenance Json // {<arg>: {source, ref?, tainted}}
  tainted        Boolean   @default(false)
  sensitivity    String    @default("ops") // CHECK ops|personal|financial
  destructive    Boolean   @default(false)
  consequential  Boolean   @default(false)
  reason         String?
  estCostUsd     Decimal?  @db.Decimal(10, 4)
  status         String    @default("pending") // CHECK pending|approved|executing|executed|failed|rejected|expired
  expiresAt      DateTime  @db.Timestamptz(3)
  approvalId     String?   @unique
  executedAt     DateTime? @db.Timestamptz(3)
  result         Json? // redacted, <= 16 KB
  error          String?
  argsPurgedAt   DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([origin])
}

/// Partitioned by month on "at" (partitions in schema flint_part); append-only.
model AuditEntry {
  id            String    @default(cuid())
  at            DateTime  @default(now()) @db.Timestamptz(3)
  seq           BigInt    @default(autoincrement())
  actor         String
  context       String // CHECK chat|autonomous|console|deploy
  kind          String // CHECK intent|decision|action|approval|rejection|spend|policy|sync|escalation|health|forget|error
  action        String
  tier          String?
  inputs        Json // ids and hashes only; <= 16 KB
  reasoning     String? // <= 1,000
  decision      String? // CHECK act|log|escalate|queue|deny
  outcome       String // CHECK pending|ok|denied|failed|skipped
  outcomeDetail Json?
  correlationId String?
  costUsd       Decimal?  @db.Decimal(10, 4)
  tainted       Boolean   @default(false)
  redactedAt    DateTime? @db.Timestamptz(3)

  @@id([id, at])
  @@index([kind, at])
  @@index([action, at])
  @@index([correlationId])
}

model AuditRollup {
  day     String
  action  String
  context String
  count   Int    @default(0)

  @@id([day, action, context])
}

/// Rollup batches already counted (a resent batch is not counted twice); kept a week.
model AuditRollupBatch {
  id String   @id
  at DateTime @default(now()) @db.Timestamptz(3)

  @@index([at])
}

/// Append-only; written by row_history().
model RowChange {
  id        String   @id @default(cuid())
  at        DateTime @default(now()) @db.Timestamptz(3)
  tableName String
  rowId     String
  actor     String
  changed   Json? // {col: [old, new]}; NULL once redacted by a forget

  @@index([tableName, rowId, at])
}

// ---------------------------------------------------------------------------
// p1_world

model Entity {
  id             String          @id @default(cuid())
  kind           String // CHECK service|repo|deployment|account|project|thread|pull_request|issue|ci_run|commitment|deadline|organization|person
  key            String
  name           String
  state          Json
  stateHash      String
  version        Int             @default(1)
  status         String          @default("active") // CHECK active|archived|merged|forgotten
  sensitivity    String          @default("ops")
  taintedPaths   String[]        @default([])
  confidence     Float?
  mergedIntoId   String?
  firstSeenAt    DateTime        @default(now()) @db.Timestamptz(3)
  lastObservedAt DateTime        @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  versions       EntityVersion[]
  sources        EntitySource[]
  outgoing       Relation[]      @relation("RelFrom")
  incoming       Relation[]      @relation("RelTo")
  predictions    Prediction[]
  texts          EntityText[]
  goals          GoalEntity[]

  @@unique([kind, key])
  @@index([kind, status, updatedAt])
}

/// Append-only (guard_append_only: state, patch).
model EntityVersion {
  id            String   @id @default(cuid())
  entityId      String
  entity        Entity   @relation(fields: [entityId], references: [id], onDelete: Restrict)
  version       Int
  changeKind    String // CHECK created|updated|archived|restored|merged|corrected|forgotten
  state         Json?
  patch         Json?
  actor         String
  sourceEventId String? // plain reference; SourceEvent rows age out
  tainted       Boolean  @default(false)
  validFrom     DateTime @db.Timestamptz(3)
  recordedAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([entityId, version])
  @@index([entityId, validFrom])
  @@index([sourceEventId])
}

/// relation_close_only: only validTo may change, only from NULL.
model Relation {
  id            String    @id @default(cuid())
  type          String // CHECK owns|depends_on|runs|deploys|of_repo|has_thread|has_pr|has_issue|committed_to|due_for|member_of|attends|blocks
  fromId        String
  from          Entity    @relation("RelFrom", fields: [fromId], references: [id], onDelete: Restrict)
  toId          String
  to            Entity    @relation("RelTo", fields: [toId], references: [id], onDelete: Restrict)
  attrs         Json?
  confidence    Float?
  tainted       Boolean   @default(false)
  validFrom     DateTime  @db.Timestamptz(3)
  validTo       DateTime? @db.Timestamptz(3)
  sourceEventId String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([fromId, type, validTo])
  @@index([toId, type, validTo])
  @@index([sourceEventId])
}

/// p25_google: untrusted text about an entity, kept out of the world model so
/// it can be deleted (a calendar event's title). Refreshed while the entity is
/// seen; retention deletes it 7 days after it last was, forget at once.
model EntityText {
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Restrict)
  field      String // CHECK title
  text       String
  source     String
  tainted    Boolean  @default(true) // CHECK tainted
  observedAt DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([entityId, field])
  @@index([observedAt])
}

model EntitySource {
  id           String   @id @default(cuid())
  entityId     String
  entity       Entity   @relation(fields: [entityId], references: [id], onDelete: Restrict)
  source       String // CHECK launchd|health|git|spend|github|railway|nexus|google|deploy|knowledge|nexus_inbox|google_calendar|apple_calendar
  externalId   String
  namespace    String?
  accountOwner String // CHECK = 'will'
  firstSeenAt  DateTime @default(now()) @db.Timestamptz(3)
  lastSyncedAt DateTime @db.Timestamptz(3)

  @@unique([source, externalId])
  @@index([entityId])
}

/// Mutable inbox; retention nulls payloads and deletes rows at 13 months.
model SourceEvent {
  id          String          @id @default(cuid())
  source      String
  sourceRef   String
  type        String
  occurredAt  DateTime        @db.Timestamptz(3)
  receivedAt  DateTime        @default(now()) @db.Timestamptz(3)
  sensitivity String
  tainted     Boolean         @default(false)
  payload     Json? // <= 16 KB
  payloadHash String
  status      String          @default("received") // CHECK received|applied|ignored|failed|dead
  attempts    Int             @default(0)
  lastError   String? // <= 500, redacted
  processedAt DateTime?       @db.Timestamptz(3)
  decision    TriageDecision?

  @@unique([source, sourceRef])
  @@index([status, receivedAt])
  @@index([source, occurredAt])
}

/// Turning a source on needs an approved world.source.enable proposal (source_enable_guard).
model SourceCursor {
  source              String    @id // CHECK launchd|health|git|spend|github|railway|nexus|google|deploy|knowledge|nexus_inbox|google_calendar|apple_calendar
  cursor              String
  etag                String?
  enabled             Boolean   @default(false)
  lastOkAt            DateTime? @db.Timestamptz(3)
  lastError           String?
  consecutiveFailures Int       @default(0)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)
}

model SuppressedKey {
  source         String
  externalIdHash String
  approvalId     String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@id([source, externalIdHash])
}

model MetricSeries {
  key           String        @id
  entityId      String?
  unit          String
  freq          String // CHECK raw|D|W|M
  sensitivity   String
  offBoxAllowed Boolean       @default(false)
  description   String
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  points        MetricPoint[]
}

model MetricPoint {
  seriesKey String
  series    MetricSeries @relation(fields: [seriesKey], references: [key], onDelete: Restrict)
  at        DateTime     @db.Timestamptz(3)
  value     Float

  @@id([seriesKey, at])
}

model BackupRun {
  id              String    @id @default(cuid())
  kind            String // CHECK pg_dump_flint|flint_tar|nexus_railway_dump
  location        String // CHECK local|icloud
  path            String
  bytes           BigInt?
  sha256          String?
  encrypted       Boolean
  status          String // CHECK ok|failed
  startedAt       DateTime  @db.Timestamptz(3)
  finishedAt      DateTime? @db.Timestamptz(3)
  restoreTestedAt DateTime? @db.Timestamptz(3)
  restoreOk       Boolean?
  restoreDetail   Json?

  @@index([kind, startedAt])
}

// ---------------------------------------------------------------------------
// p1_ledger

/// prediction_guard: only status, supersededAt, lateSupersession and voidApprovalId change.
/// P3: goalId only on the goals writer's own predictions (Prediction_goal_check), and never changes.
model Prediction {
  id                        String          @id @default(cuid())
  claim                     String // <= 300
  kind                      String          @default("binary") // CHECK binary|interval
  probability               Float?
  method                    String // CHECK model_reasoning|prophet|rule|base_rate|human
  model                     String?
  modelConfig               Json?
  domain                    String // CHECK services|deploys|spend|repos|projects|calendar|goals|assets|selfmod|triage|recommendation
  type                      String // CHECK event_occurs|deadline_met|threshold_cross|trend|relevance|task_meets_bar|effect_given_accept
  evidence                  Json
  resolutionCriteria        String
  resolver                  String // CHECK auto_world|auto_metric|will|conditional
  resolverSpec              Json?
  conditionRecommendationId String?
  resolveBy                 DateTime        @db.Timestamptz(3)
  subjectEntityId           String?
  subjectEntity             Entity?         @relation(fields: [subjectEntityId], references: [id], onDelete: Restrict)
  supersedesId              String?         @unique
  supersedes                Prediction?     @relation("Supersede", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy              Prediction?     @relation("Supersede")
  supersededAt              DateTime?       @db.Timestamptz(3)
  lateSupersession          Boolean         @default(false)
  status                    String          @default("open") // CHECK open|resolved|expired|superseded|condition_unmet|void
  voidApprovalId            String?
  tainted                   Boolean         @default(false)
  createdBy                 String
  createdAt                 DateTime        @default(now()) @db.Timestamptz(3)
  goalId                    String?
  goal                      Goal?           @relation(fields: [goalId], references: [id], onDelete: Restrict)
  resolution                Resolution?
  recommendation            Recommendation? @relation("RecPrediction")
  goalReview                GoalReview?

  @@index([status, resolveBy])
  @@index([domain, type, createdAt])
  @@index([subjectEntityId])
  @@index([goalId])
}

/// Append-only; resolution_leak_guard checks eventAt >= the prediction's createdAt.
model Resolution {
  id           String                 @id @default(cuid())
  predictionId String                 @unique
  prediction   Prediction             @relation(fields: [predictionId], references: [id], onDelete: Restrict)
  outcome      Boolean?
  outcomeValue Float?
  eventAt      DateTime               @db.Timestamptz(3)
  resolvedAt   DateTime               @default(now()) @db.Timestamptz(3)
  resolvedBy   String // CHECK auto_world|auto_metric|will
  evidence     Json?
  brier        Float?
  corrections  ResolutionCorrection[]
}

/// Append-only; needs an approved correction Approval.
model ResolutionCorrection {
  id           String     @id @default(cuid())
  resolutionId String
  resolution   Resolution @relation(fields: [resolutionId], references: [id], onDelete: Restrict)
  outcome      Boolean?
  outcomeValue Float?
  reason       String
  approvalId   String
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
}

model Recommendation {
  id             String     @id @default(cuid())
  templateId     String
  params         Json
  domain         String
  type           String // CHECK tool_call|goal|plan_change|task_dispatch|pr|escalation_action
  text           String?
  rationale      String? // <= 300
  expectedEffect String? // <= 300
  predictionId   String     @unique
  prediction     Prediction @relation("RecPrediction", fields: [predictionId], references: [id], onDelete: Restrict)
  proposalId     String?    @unique
  status         String     @default("proposed") // CHECK proposed|accepted|rejected|expired|superseded
  decidedAt      DateTime?  @db.Timestamptz(3)
  approvalId     String?
  effectObserved Boolean?
  outcomeAt      DateTime?  @db.Timestamptz(3)
  outcomeNote    String? // <= 300
  tainted        Boolean    @default(false)
  createdBy      String
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)

  @@index([domain, status, createdAt])
}

model CalibrationSnapshot {
  id              String   @id @default(cuid())
  computedAt      DateTime @default(now()) @db.Timestamptz(3)
  windowStart     DateTime @db.Timestamptz(3)
  windowEnd       DateTime @db.Timestamptz(3)
  domain          String
  type            String
  method          String
  n               Int
  nOpen           Int
  nExpired        Int
  nConditionUnmet Int
  nVoid           Int
  nLateSuperseded Int
  brier           Float
  baseRate        Float
  brierSkill      Float?
  reliability     Json
  unresolvedRate  Float

  @@unique([windowEnd, domain, type, method])
}

// ---- P2: triage, surfacing and runtime health ---------------------------------------

/// A triage rule is policy: inserted only as the exact rule of an approved
/// triage.rule.create proposal being executed; afterwards only switched off.
/// Critical rules are code, never rows.
model TriageRule {
  id                String   @id @default(cuid())
  name              String   @unique
  source            String
  eventType         String
  predicate         Json // {all|any: [{path, op, value}]}; structural paths only
  action            String // CHECK ignore|log|act|escalate
  lane              String // CHECK quiet|relevant
  priority          Int      @default(100)
  perSenderDailyCap Int?
  enabled           Boolean  @default(true)
  createdBy         String // CHECK will|flint
  approvalId        String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
}

/// What triage decided about one applied event; only Will's label is added later.
model TriageDecision {
  id                    String      @id @default(cuid())
  sourceEventId         String      @unique
  sourceEvent           SourceEvent @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  action                String // CHECK ignore|log|act|escalate
  lane                  String // CHECK quiet|relevant
  relevance             Float?
  reasonCode            String?
  ruleName              String?
  decidedBy             String // code:<rule> | rule:<name> | model:ollama:<model> | fallback:<why> | default
  critical              Boolean     @default(false)
  /// Decided while triage ran in shadow (nothing was delivered or filed).
  shadow                Boolean     @default(true)
  reasoning             String? // <= 500; purged at 7 d for personal/tainted
  modelMs               Int?
  relevancePredictionId String?     @unique
  feedback              String? // CHECK should_escalate|should_be_quiet|ok
  feedbackAt            DateTime?   @db.Timestamptz(3)
  tainted               Boolean     @default(false)
  sensitivity           String
  createdAt             DateTime    @default(now()) @db.Timestamptz(3)
  escalation            Escalation?

  @@index([lane, createdAt])
}

/// A note for Will, rendered from a template; probability text only from its Prediction row.
model Escalation {
  id               String               @id @default(cuid())
  triageDecisionId String               @unique
  triageDecision   TriageDecision       @relation(fields: [triageDecisionId], references: [id], onDelete: Restrict)
  templateId       String
  fields           Json // typed template params
  title            String? // <= 80; the field-free title once purged
  body             String? // <= 500
  predictionId     String?
  recommendationId String?
  channels         String[] // inapp|banner|push (push is content-free)
  status           String               @default("open") // CHECK open|acked|dismissed|acted|expired
  actedAuditId     String?
  useful           Boolean?
  tainted          Boolean              @default(false)
  sensitivity      String
  contentPurgedAt  DateTime?            @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  ackedAt          DateTime?            @db.Timestamptz(3)
  deliveries       EscalationDelivery[]

  @@index([status, createdAt])
}

/// The outbox: one row per channel an escalation goes out on. held = its notify action is not promoted.
model EscalationDelivery {
  id           String     @id @default(cuid())
  escalationId String
  escalation   Escalation @relation(fields: [escalationId], references: [id], onDelete: Restrict)
  channel      String // CHECK inapp|banner|push
  status       String     @default("pending") // CHECK pending|sent|failed|held
  attempts     Int        @default(0)
  lastError    String? // a class, never a tool's words
  sentAt       DateTime?  @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([escalationId, channel])
  @@index([status, createdAt])
}

model RuntimeInstance {
  id         String    @id @default(cuid())
  gitSha     String
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastBeatAt DateTime  @db.Timestamptz(3)
  stoppedAt  DateTime? @db.Timestamptz(3)
  stopReason String?

  @@index([lastBeatAt])
}

model HealthCheck {
  id        String   @id @default(cuid())
  component String
  status    String // CHECK ok|degraded|down|unknown|disabled
  detail    String? // <= 300, redacted
  at        DateTime @default(now()) @db.Timestamptz(3)

  @@index([component, at])
}

// ---------------------------------------------------------------------------
// p3_goals
// Goal text is PERSONAL: RowChange keeps only its length (row_history_masked),
// and a card's reason and error never carry it.

/// goal_insert_check: born proposed and unsigned. goal_guard: becoming active,
/// done or abandoned, and changing what counts as done or its timing, each only
/// as the exact args of an executing card Will signed (p3_signed_proposal).
model Goal {
  id              String       @id @default(cuid())
  title           String // 1..120
  description     String       @default("") // <= 1,000
  owner           String // CHECK will|flint
  origin          String // CHECK will|flint
  status          String       @default("proposed") // CHECK proposed|active|paused|done|abandoned|rejected
  priority        Int          @default(3) // 1..5
  successCriteria Json         @default("[]") // [{id, text, check}], <= 10
  criteriaMet     Json         @default("{}") // Will's manual marks: {criterionId: YYYY-MM-DD}
  horizonAt       DateTime?    @db.Timestamptz(3)
  reviewCadence   String       @default("P1W") // CHECK P1D|P3D|P1W|P2W|P1M
  nextReviewAt    DateTime?    @db.Timestamptz(3) // set while active
  activatedAt     DateTime?    @db.Timestamptz(3) // set once, by the trigger
  progress        Float        @default(0)
  approvalId      String? // the latest signed change; plain reference, checked by trigger
  sensitivity     String       @default("personal") // personal|financial; signed on goal.activate with owner, origin, tainted and nexusProjectId
  tainted         Boolean      @default(false)
  nexusProjectId  String?
  sourceRef       String?      @unique // chat:<sha256>, for chat suggestions only
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  plans           Plan[]
  reviews         GoalReview[]
  links           GoalEntity[]
  predictions     Prediction[]

  @@index([status, nextReviewAt])
}

/// What a goal is about. goal_entity_guard: added and removed only as the signed
/// card's links; afterwards only its watch cursor moves forward. No history: no id.
model GoalEntity {
  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Restrict)
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id], onDelete: Restrict)
  role        String // CHECK target|depends_on|watch
  watchPaths  String[] @default([]) // top-level patch keys, never name or title
  seenVersion Int      @default(0) // the watch cursor: the entity's version when linked, then the last one read
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([goalId, entityId])
  @@index([entityId])
}

/// plan_guard: a version becomes active only as the previous one plus exactly the
/// signed ops (one active per goal, Plan_one_active_key); superseded is final.
model Plan {
  id          String     @id @default(cuid())
  goalId      String
  goal        Goal       @relation(fields: [goalId], references: [id], onDelete: Restrict)
  version     Int
  status      String     @default("draft") // CHECK draft|active|superseded
  rationale   String     @default("") // <= 300, template text
  assumptions Json       @default("[]")
  createdBy   String // CHECK will|flint
  approvalId  String?    @unique // one version per approval
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  steps       PlanStep[]

  @@unique([goalId, version])
}

/// plan_step_guard: written into a draft; on the active plan only its progress
/// changes, never into skipped; a Flint action is done only with its own ok action (H7).
model PlanStep {
  id          String    @id @default(cuid())
  planId      String
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  key         String // s<n>, stable across versions
  ordinal     Int
  title       String // 1..200
  kind        String // CHECK will_task|flint_action|asset_task|wait|decision
  status      String    @default("todo") // CHECK todo|in_progress|blocked|done|skipped
  tier        String    @default("approval") // CHECK alone|approval|forbidden
  dueAt       DateTime? @db.Timestamptz(3)
  dependsOn   String[]  @default([]) // step keys
  proposalId  String?
  taskId      String?
  doneAuditId String? // AuditEntry is partitioned: checked by trigger, not a foreign key
  doneAt      DateTime? @db.Timestamptz(3)

  @@unique([planId, key])
  @@index([planId, ordinal])
  @@index([status, dueAt])
}

/// goal_review_insert_check: only for an active goal, with an open goals
/// prediction of that goal. goal_review_guard: only planner, diff and proposalId
/// are set later, once each.
model GoalReview {
  id             String     @id @default(cuid())
  goalId         String
  goal           Goal       @relation(fields: [goalId], references: [id], onDelete: Restrict)
  kind           String // CHECK scheduled|triggered|requested
  triggerEventId String? // version:<id> | step:<key>@<ms> | resolution:<id> | chat:<ref>
  dueAt          DateTime?  @db.Timestamptz(3) // the nextReviewAt a scheduled review answers
  summary        String // <= 1,000; template sentences from counts
  criteria       Json       @default("[]") // [{id, state}]
  progressBefore Float
  progressAfter  Float
  predictionId   String     @unique
  prediction     Prediction @relation(fields: [predictionId], references: [id], onDelete: Restrict)
  reviewer       String     @default("flint:rule")
  planner        String? // ollama:<model> | none:<why>
  diff           Json? // template ops only
  proposalId     String?
  shadow         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)

  @@index([goalId, createdAt])
}

/// One-use approvals (p3_bind_approval): a signed card moves its goal in one
/// transaction only, however long the card stays executing. Written only by that
/// SECURITY DEFINER helper; flint_app has no grant on it.
model GoalApprovalUse {
  approvalId String   @id
  goalId     String
  action     String
  xact       String // the transaction that used it (pg_current_xact_id)
  usedAt     DateTime @default(now()) @db.Timestamptz(3)
}
