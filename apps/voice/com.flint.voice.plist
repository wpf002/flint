<?xml version="1.0" encoding="UTF-8"?>
<!-- Always-on "Hey Flint" voice assistant. Install on the Mac Studio:
     cp com.flint.voice.plist ~/Library/LaunchAgents/ ; launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.flint.voice.plist
     (Grant Terminal/the script Microphone access in System Settings > Privacy.) -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.flint.voice</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/willfoti/.flint/voice/voice_client.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/willfoti/.flint/voice.out.log</string>
  <key>StandardErrorPath</key><string>/Users/willfoti/.flint/voice.err.log</string>
</dict>
</plist>
