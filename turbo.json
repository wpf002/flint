{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "agentGuidance": false,
  "globalDependencies": [
    "tsconfig.base.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "outputs": [],
      "cache": false
    }
  }
}
